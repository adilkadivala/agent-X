LLM_PROVIDER=ollama
LLM_API_KEY=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=gemma4:31b-cloud
# Switch anytime:
# LLM_PROVIDER=openai|openrouter|grok|anthropic|ollama|custom
# LLM_API_KEY=...
# LLM_MODEL=gpt-4o-mini | anthropic/claude-sonnet-4 | grok-3 | claude-sonnet-4-20250514
TZ=Asia/Kolkata

DATABASE_PATH=./data/agent.db
BROWSER_PROFILE_DIR=./data/browser-profile
VOICE_SAMPLES_PATH=./voice-samples.md
INBOX_DIR=./inbox
LOCK_PATH=./data/worker.lock

# Preferred: npm run observe (keeps X open)
AGENT_MODE=engage
ENGAGE_SOURCES=timeline,following,notifications
# Legacy — unused by observe:
ENGAGE_SEARCH_QUERIES=
WATCH_HANDLES=
WATCH_TWEETS_PER_PROFILE=3
ENGAGE_TOPIC_LLM=false
MAX_TARGET_AGE_MINUTES=180
DAILY_ENGAGE_MAX=80
MIN_ENGAGE_GAP_MINUTES=3
ENGAGE_PER_CYCLE=8
ENGAGE_SKIP_RETWEETS=true
ENGAGE_SKIP_REPLIES=true
ENGAGE_ALSO_LIKE=true
ENGAGE_PREFER=auto
MIN_VIEWS=20000
MIN_VIEWS_IF_UNKNOWN=skip
OBSERVE_INTERVAL_SECONDS=180
OBSERVE_SLEEP_MIN_SECONDS=60
OBSERVE_SLEEP_MAX_SECONDS=360
PDF_POST_ENABLED=true
PDF_DIRS=/home/k-adi/school/ai-stuff/learn,/home/k-adi/school/ai-stuff/go through
PDF_DAILY_MAX=6
PDF_MIN_GAP_MINUTES=90
PDF_WORD_MIN=120
PDF_WORD_MAX=200
PDF_COMMUNITY_ID=1493446837214187523
PDF_COMMUNITY_NAME=Build in Public

# Original Content Rewards
OCR_MODE=false
OCR_IGNORE_WINDOWS=true
OCR_DAILY_MAX=50
OCR_REQUIRE_ELIGIBILITY=true
X_PREMIUM=false
MIN_FOLLOWERS=500
MIN_QUALIFIED_IMPRESSIONS=500000
FOLLOWERS_COUNT=0
OCR_TRACK_IMPRESSIONS=true
OCR_SKIP_ENGAGE=true
OCR_PDF_TO_TIMELINE=true

DRY_RUN=true
PAUSED=false
DAILY_MAX=8
POST_WINDOWS=0-24
WINDOW_JITTER=1
MIN_POST_GAP_MINUTES=45
HEADLESS=false

BANNED_PHRASES=guaranteed returns,buy now,click here,great post,so true
VOICE_THRESHOLD=0.75
INCLUDE_SOURCE_LINK=false
MAX_HASHTAGS=0
ATTACH_IMAGES=false
MEDIA_CACHE_DIR=./data/media
SCREENSHOTS_DIR=./media/screenshots
MEMES_DIR=./media/memes
MODE_WEIGHTS=hot_take=40,question=30,ship_note=20,tech_news=0,meme=5,screenshot=5
