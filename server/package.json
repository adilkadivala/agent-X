{
  "name": "x-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal light full-auto X poster via headed Playwright (no X API)",
  "scripts": {
    "build": "tsc",
    "worker": "tsx src/worker.ts",
    "observe": "tsx src/observe.ts",
    "pdf-post": "tsx src/cli/pdf-post.ts",
    "ocr:status": "tsx src/cli/ocr-status.ts",
    "browser:login": "tsx src/cli/login.ts",
    "browser:smoke": "tsx src/cli/smoke.ts",
    "eval:voice": "tsx eval/voice.eval.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cron:install": "bash scripts/install-cron.sh",
    "cron:uninstall": "bash scripts/uninstall-cron.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.50.1",
    "rss-parser": "^3.13.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
