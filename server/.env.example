PORT=4000
DASHBOARD_ORIGIN=http://localhost:3000
X_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/x/callback
SESSION_SECRET=change-me
DATABASE_URL=postgresql://supergrow:supergrow@localhost:5433/supergrow

# X developer portal credentials (OAuth 1.0a API key + secret).
# Either naming style works:
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Aliases accepted from the X portal labels:
# Consumer_Key=
# Secret_Key=
# Bearer_Token=
# Access_Token=
# Access_Token_Secret=

# OAuth 2.0 (User authentication settings in the X developer portal)
X_CLIENT_ID=
X_CLIENT_SECRET=
# Aliases from the portal labels:
# Client_ID=
# Client_Secret=
